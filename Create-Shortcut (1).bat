@echo off
setlocal
rem ---------------------------------------------------------------
rem  Create-Shortcut.bat   (ASCII only, icon is embedded in this file)
rem  Creates desktop + Start Menu shortcuts named "HK Weather Alert"
rem  with a custom icon. (An earlier Chinese-named shortcut is removed automatically.)
rem
rem  Put this file in the project folder (next to app.py) and run it.
rem    Create-Shortcut.bat            create / refresh the shortcuts
rem    Create-Shortcut.bat /remove    delete the shortcuts again
rem ---------------------------------------------------------------
set "APPDIR=%~dp0"
set "SELF=%~f0"
set "MODE=%~1"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:SELF); $i=$t.LastIndexOf('#PS-BEGIN'); Invoke-Expression $t.Substring($i)"
echo.
pause
exit /b
#PS-BEGIN
$ErrorActionPreference = 'Stop'
$b64 = @'

'@
$app   = $env:APPDIR.TrimEnd('\')
$name  = 'HK Weather Alert'                                 # shortcut name
$oldName = -join ([char[]](0x6E2F,0x5929,0x9884,0x8B66))      # earlier Chinese-named shortcut, cleaned up automatically
$desktop   = [Environment]::GetFolderPath('Desktop')
$startMenu = [Environment]::GetFolderPath('Programs')
$links    = @((Join-Path $desktop ($name + '.lnk')), (Join-Path $startMenu ($name + '.lnk')))
$oldLinks = @((Join-Path $desktop ($oldName + '.lnk')), (Join-Path $startMenu ($oldName + '.lnk')))

foreach ($l in $oldLinks) { if (Test-Path -LiteralPath $l) { Remove-Item -LiteralPath $l -Force; Write-Host "Removed old shortcut: $l" } }

if ($env:MODE -eq '/remove') {
    foreach ($l in $links) { if (Test-Path -LiteralPath $l) { Remove-Item -LiteralPath $l -Force; Write-Host "Removed: $l" } }
    return
}

$entry = Join-Path $app 'app.py'
if (-not (Test-Path -LiteralPath $entry)) { Write-Host "app.py not found in $app - put this file in the project folder." -ForegroundColor Red; return }
$py = Join-Path $app '.venv\Scripts\pythonw.exe'
if (-not (Test-Path -LiteralPath $py)) {
    $c = Get-Command pythonw.exe -ErrorAction SilentlyContinue
    if ($c) { $py = $c.Source }
}
if (-not (Test-Path -LiteralPath $py)) { Write-Host 'pythonw.exe not found (.venv\Scripts\pythonw.exe or on PATH).' -ForegroundColor Red; return }

# 1) write the embedded icon next to the app
$assets = Join-Path $app 'assets'
New-Item -ItemType Directory -Force -Path $assets | Out-Null
$ico = Join-Path $assets 'app_icon.ico'
[IO.File]::WriteAllBytes($ico, [Convert]::FromBase64String($b64.Trim()))

# 2) create the shortcuts
$sh = New-Object -ComObject WScript.Shell
foreach ($l in $links) {
    $s = $sh.CreateShortcut($l)
    $s.TargetPath       = $py
    $s.Arguments        = '"' + $entry + '"'
    $s.WorkingDirectory = $app
    $s.IconLocation     = $ico + ',0'
    $s.Description      = 'HK Weather Alert - Hong Kong weather warnings to WhatsApp groups'
    $s.WindowStyle      = 1
    $s.Save()
    Write-Host "Created: $l" -ForegroundColor Green
}
try { & "$env:SystemRoot\System32\ie4uinit.exe" -show } catch { }   # refresh the icon cache
Write-Host ''
Write-Host 'Done. Icon file:' $ico
return
